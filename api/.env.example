# Copy this file to .env and fill in your values.
# .env is git-ignored and will NOT be committed.

DATABASE_URL=postgres://user:password@host:5432/dbname
GIS_HOST=maps5.vcgov.org
POLL_INTERVAL=60
LOG_LEVEL=debug
WEBCAM_URL=https://kubrick.htvapps.com/htv-prod-media.s3.amazonaws.com/images/dynamic/wesh/CAM13.jpg
NOAA_TIDE_STATION=8721147
NOAA_TEMP_STATIONS=8721604,8720218
NDBC_STATION=41113
WEEKEND_OUTLOOK_ENABLED=true
# NWS_BASE_URL=            # unset = api.weather.gov; override to proxy via the cam droplet
NWS_LAND_GRIDPOINT=MLB/42,92
NWS_MARINE_GRIDPOINT=MLB/46,93
SURF_REPORT_ENABLED=true
NWS_SRF_OFFICE=KMLB
NWS_SRF_ZONE=FLZ141
CONDITIONS_INTERVAL=30
CONDITIONS_ENABLED=true
ADMIN_API_KEY=change-me-to-a-secret
