<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged into the generated Info.plist (GENERATE_INFOPLIST_FILE stays
	     YES; this file carries only what build settings cannot express).
	     Alternative spoken names for Siri: the home-screen label is "Beach
	     Info", the product is "Volusia Beach Info", and the bundle name is
	     the historical "BeachRamp" — Siri should answer to those too. -->
	<key>INAlternativeAppNames</key>
	<!-- App Store Connect allows at most three synonyms per language
	     (ITMS-90626, build 36). "Beach Info" itself is the display name and
	     needs no synonym. -->
	<array>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Volusia Beach Info</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Volusia Beach</string>
		</dict>
		<dict>
			<key>INAlternativeAppName</key>
			<string>Beach Ramp</string>
		</dict>
	</array>
</dict>
</plist>
