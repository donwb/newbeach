<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The watch app writes the board snapshot and the widget pins here;
	     the watch widget extension reads them. Same group id as the phone,
	     but a separate container on the watch — nothing syncs across. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.donwb.BeachRampTV</string>
	</array>
</dict>
</plist>
