<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used by apple/scripts/flight.sh: export straight to App Store Connect.
	     One plist serves both the iOS and tvOS archives. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>destination</key>
	<string>upload</string>
	<key>teamID</key>
	<string>YR2B55YA56</string>
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Config/Version.xcconfig is the single source of truth for build
	     numbers; don't let the upload renumber it. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
	<key>uploadSymbols</key>
	<true/>
</dict>
</plist>
